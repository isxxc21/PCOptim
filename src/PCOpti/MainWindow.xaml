<Window x:Class="PCOpti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCOpti.ViewModels"
        Title="PCOpti" Width="1180" Height="760" MinWidth="900" MinHeight="580"
        Icon="pack://application:,,,/Assets/pcopti.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- Custom chrome: our own dark title bar, but Windows still handles snapping, resizing and the shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,9">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- When maximised, Windows puts the frame off-screen; this margin keeps content visible. -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================= Sidebar ======================= -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,24">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PCOpti" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="Honest PC tuning" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="22,10,22,18">
                        <Button Style="{StaticResource GhostButton}" Padding="0" HorizontalAlignment="Left"
                                Command="{Binding OpenSettingsCommand}"
                                Visibility="{Binding UpdateNotice, Converter={StaticResource NotEmptyToVis}}">
                            <TextBlock Text="{Binding UpdateNotice}" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                        </Button>
                        <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Open source · MIT · No telemetry" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <!-- Navigation -->
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                             Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource NavListItem}"
                             AutomationProperties.Name="Navigation">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="16" Width="22" />
                                    <TextBlock Text="{Binding Title}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ======================= Content ======================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar (drag area is provided by WindowChrome) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimise" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximise" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
                </StackPanel>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
