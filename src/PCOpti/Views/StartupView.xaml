<UserControl x:Class="PCOpti.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,6,36,32" MaxWidth="1060">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Startup Apps" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,20,0"
                               Text="Programs that start when you sign in, from the registry Run keys, Startup folders and Task Scheduler. Switching one off works like Task Manager: nothing is deleted and you can switch it back on at any time." />
                </StackPanel>
            </DockPanel>

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <ContentControl Margin="0,14,0,0" Content="{Binding}" ContentTemplate="{StaticResource StatusBanner}" Focusable="False" />

            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource SubtleTextBrush}" Margin="2,0,0,4" />
            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,12" TextWrapping="Wrap"
                       Text="Impact is a rough estimate based on the program's size. Windows doesn't let other apps read its own startup measurements. Windows' own scheduled tasks are never listed." />

            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="15" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0">
                                        <Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SourceText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Est. impact" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ImpactText}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{Binding Impact, Converter={StaticResource ImpactBrush}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Disabled" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Text" Value="Enabled" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Name}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
