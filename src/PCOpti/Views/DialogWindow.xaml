<Window x:Class="PCOpti.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCOpti" Width="500" SizeToContent="Height" MaxHeight="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0"
                       Foreground="{DynamicResource AccentBrush}" Text="&#xE946;" />
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="400" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" FontSize="14"
                       Foreground="{StaticResource TextBrush}" />
        </ScrollViewer>

        <Border x:Name="WarningBox" Grid.Row="2" Margin="0,14,0,0" Padding="12,10" CornerRadius="8"
                Background="#2B2312" BorderBrush="#5A4413" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ModerateBrush}"
                           VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock x:Name="WarningText" Style="{StaticResource BodyText}" Foreground="#F3D08A" MaxWidth="400" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="ButtonPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
    </Grid>
</Window>
