<UserControl x:Class="PCOpti.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,6,36,32" MaxWidth="1060">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <TextBlock Text="THEME" Style="{StaticResource SectionHeader}" Margin="2,22,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Accent colour" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" Style="{StaticResource PlainListBox}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Margin="0,0,8,0" BorderThickness="1"
                                                    BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="16" Height="16" Fill="{Binding Brush}" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,10,0,0"
                               Text="PCOpti uses a dark theme designed for gaming setups. The accent colour changes immediately." />
                </StackPanel>
            </Border>

            <TextBlock Text="UPDATES" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Check for updates" Style="{StaticResource PrimaryButton}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0" />
                        <Button Content="Open release page" Command="{Binding OpenUpdateCommand}"
                                Visibility="{Binding UpdateUrl, Converter={StaticResource NotEmptyToVis}}" />
                    </WrapPanel>
                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding UpdateMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding UpdateMessage, Converter={StaticResource NotEmptyToVis}}" />
                    <DockPanel Margin="0,14,0,0">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckOnStartup}" />
                        <StackPanel>
                            <TextBlock Text="Check for updates when PCOpti starts" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                       Text="Off by default. When on, PCOpti asks the public GitHub Releases API for the latest version number, and that's all. It never downloads or installs anything by itself." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="15">
                        <Run Text="PCOpti" FontWeight="Bold" /> <Run Text="{Binding VersionText, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                               Text="Free, open-source PC optimiser for gamers. MIT License. No telemetry, no ads, no bundled software. Your backups and change log stay on this PC in %LocalAppData%\PCOpti." />
                    <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenRepoCommand}">
                        <TextBlock Text="{Binding RepoUrl}" Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline" />
                    </Button>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,12,0,0"
                               Text="Disclaimer: PCOpti modifies Windows system settings. Every change is backed up and reversible, but you use it at your own risk. The software is provided as-is, without warranty of any kind." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
