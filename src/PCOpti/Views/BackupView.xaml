<UserControl x:Class="PCOpti.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,6,36,32" MaxWidth="1060">
            <TextBlock Text="Backup &amp; Restore" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Before any change, PCOpti saves the exact original value. Each tweak has its own Revert button, or you can undo everything here." />

            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <ContentControl Margin="0,14,0,0" Content="{Binding}" ContentTemplate="{StaticResource StatusBanner}" Focusable="False" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding RevertAllCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Revert all PCOpti changes" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CreateRestorePointCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Create System Restore point" />
                            </StackPanel>
                        </Button>
                        <Button Content="Open backup folder" Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <DockPanel Margin="0,8,0,0">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AskForRestorePoint}" />
                        <StackPanel>
                            <TextBlock Text="Offer a restore point before the first change of each session" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                       Text="Windows allows one restore point every 24 hours by default, and System Protection must be turned on for drive C:." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="SAVED ORIGINAL SETTINGS" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Nothing is backed up right now: PCOpti hasn't changed anything (or everything was reverted)."
                       Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding Details}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Clear log" Style="{StaticResource GhostButton}" Command="{Binding ClearLogCommand}" VerticalAlignment="Bottom" />
                <TextBlock Text="CHANGE LOG" Style="{StaticResource SectionHeader}" />
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding Log}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Action, Converter={StaticResource ActionBrush}}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailsText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0"
                                                   Visibility="{Binding DetailsText, Converter={StaticResource NotEmptyToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
