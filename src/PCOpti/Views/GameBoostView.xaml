<UserControl x:Class="PCOpti.Views.GameBoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,6,36,24" MaxWidth="1060">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Game Boost" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,20,0"
                           Text="Before you play, close background apps you picked and, if you like, give your game higher CPU priority. Nothing here is permanent. The real gain depends on how much those apps were using. It helps most on PCs with 8 GB of RAM or a 4-core CPU." />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <ProgressBar Style="{StaticResource BusyBar}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <ContentControl Margin="0,8,0,0" Content="{Binding}" ContentTemplate="{StaticResource StatusBanner}" Focusable="False" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Close apps -->
            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Close background apps" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,10"
                                   Text="Tick the apps to close. They're asked to close normally so they can save. Windows components are never listed." />
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Close selected" Style="{StaticResource PrimaryButton}" Command="{Binding CloseSelectedCommand}" Margin="0,0,8,0" />
                        <Button Command="{Binding ReopenClosedCommand}"
                                Visibility="{Binding ClosedCount, Converter={StaticResource PositiveToVis}}">
                            <TextBlock>
                                <Run Text="Reopen closed apps (" /><Run Text="{Binding ClosedCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </Button>
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding Apps}" Style="{StaticResource PlainListBox}" MinHeight="200"
                             ItemContainerStyle="{StaticResource SelectableItem}" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Priority -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel>
                            <TextBlock Text="Raise game priority" Style="{StaticResource CardTitle}" Margin="0,0,10,0" />
                            <Border Style="{StaticResource Pill}" Background="#22E3A21A" BorderBrush="{StaticResource ModerateBrush}">
                                <TextBlock Text="Moderate" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ModerateBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,10"
                                   Text="Sets the selected game to High CPU priority (never Realtime). It only helps when other programs compete for the CPU, and it resets when the game closes. Some anti-cheat systems block it." />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <WrapPanel>
                            <Button Content="Raise to High" Style="{StaticResource PrimaryButton}" Command="{Binding RaisePriorityCommand}" Margin="0,0,8,0" />
                            <Button Content="Restore" Command="{Binding RestorePriorityCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding PriorityMessage}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Style="{StaticResource PlainListBox}"
                             ItemContainerStyle="{StaticResource SelectableItem}" MinHeight="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
